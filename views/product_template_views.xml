<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Por qué: Agrega campo Actividad AFIP en la pestaña Contabilidad del producto.
         Se hereda de product.template.common.form para que aparezca en todos los tipos. -->
    <record id="product_template_form_inherit_afip_activity" model="ir.ui.view">
        <field name="name">product.template.form.afip.activity</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="account.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='accounting']//group[@name='accounting']" position="inside">
                <field name="l10n_ar_afip_activity_code"
                       placeholder="Ej: 620100"/>
            </xpath>
        </field>
    </record>

</odoo>
