<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="libro_iva_digital_wizard_form" model="ir.ui.view">
        <field name="name">libro.iva.digital.wizard.form</field>
        <field name="model">libro.iva.digital.wizard</field>
        <field name="arch" type="xml">
            <form string="Libro IVA Digital - ARCA">

                <!-- Estado draft: selección de período -->
                <group invisible="state != 'draft'">
                    <group string="Período">
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group string="IVA Simple (F.2051)">
                        <field name="actividad_afip"/>
                    </group>
                </group>

                <!-- Estado done: notebook con pestañas -->
                <notebook invisible="state != 'done'">

                    <!-- Pestaña 1: DDJJ IVA preview -->
                    <page string="DDJJ IVA" name="page_ddjj">
                        <field name="ddjj_iva_html" nolabel="1"/>
                    </page>

                    <!-- Pestaña 2: Archivos generados -->
                    <page string="Archivos" name="page_archivos">
                        <group string="Resumen">
                            <field name="resumen" nolabel="1" colspan="2"/>
                        </group>
                        <group string="Archivos TXT Generados">
                            <field name="ventas_cbte_file" filename="ventas_cbte_name"/>
                            <field name="ventas_cbte_name" invisible="1"/>
                            <field name="ventas_alic_file" filename="ventas_alic_name"/>
                            <field name="ventas_alic_name" invisible="1"/>
                            <field name="compras_cbte_file" filename="compras_cbte_name"/>
                            <field name="compras_cbte_name" invisible="1"/>
                            <field name="compras_alic_file" filename="compras_alic_name"/>
                            <field name="compras_alic_name" invisible="1"/>
                        </group>
                    </page>

                    <!-- Pestaña 3: CSV IVA Simple -->
                    <page string="IVA Simple" name="page_iva_simple">
                        <group string="CSV Apertura de otros conceptos (F.2051)">
                            <field name="iva_simple_debito_csv"
                                   filename="iva_simple_debito_csv_name"/>
                            <field name="iva_simple_debito_csv_name" invisible="1"/>
                            <field name="iva_simple_rest_debito_csv"
                                   filename="iva_simple_rest_debito_csv_name"/>
                            <field name="iva_simple_rest_debito_csv_name" invisible="1"/>
                            <field name="iva_simple_credito_csv"
                                   filename="iva_simple_credito_csv_name"/>
                            <field name="iva_simple_credito_csv_name" invisible="1"/>
                            <field name="iva_simple_rest_credito_csv"
                                   filename="iva_simple_rest_credito_csv_name"/>
                            <field name="iva_simple_rest_credito_csv_name" invisible="1"/>
                        </group>
                    </page>

                    <!-- Pestaña 4: Procesador de errores ARCA -->
                    <page string="Errores ARCA" name="page_errores">
                        <group>
                            <field name="errores_arca_tipo"/>
                            <field name="errores_arca_csv"
                                   filename="errores_arca_csv_name"/>
                            <field name="errores_arca_csv_name" invisible="1"/>
                        </group>
                        <div>
                            <button name="action_procesar_errores"
                                    string="Identificar Comprobantes"
                                    type="object"
                                    class="btn-primary"/>
                        </div>
                        <field name="errores_arca_html" nolabel="1"/>
                        <field name="line_map_json" invisible="1"/>
                    </page>

                </notebook>

                <field name="state" invisible="1"/>

                <footer>
                    <button name="action_generar"
                            string="Generar Archivos"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_descargar_zip"
                            string="Descargar ZIP"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'done'"/>
                    <button string="Cerrar"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_libro_iva_digital_wizard" model="ir.actions.act_window">
        <field name="name">Libro IVA Digital</field>
        <field name="res_model">libro.iva.digital.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
