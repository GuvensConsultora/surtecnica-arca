<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Tree view — diseño comparativo lado a lado:
        RESULTADO | PROVEEDOR | COMPROBANTE ARCA | $ ARCA vs $ ODOO | DETALLE
    -->
    <record id="view_mis_comprobantes_line_tree" model="ir.ui.view">
        <field name="name">guvens.mis.comprobantes.line.tree</field>
        <field name="model">guvens.mis.comprobantes.line</field>
        <field name="arch" type="xml">
            <tree default_order="state, partner_name"
                  decoration-success="state == 'match'"
                  decoration-warning="state == 'mismatch'"
                  decoration-danger="state == 'missing_in_odoo'"
                  decoration-info="state == 'missing_in_afip'">

                <!-- ═══ Resultado ═══ -->
                <field name="state" widget="badge"
                       decoration-success="state == 'match'"
                       decoration-warning="state == 'mismatch'"
                       decoration-danger="state == 'missing_in_odoo'"
                       decoration-info="state == 'missing_in_afip'"/>
                <field name="match_score" string="%"
                       decoration-success="match_score &gt;= 80"
                       decoration-warning="match_score &gt;= 40 and match_score &lt; 80"
                       decoration-danger="match_score &gt; 0 and match_score &lt; 40"/>

                <!-- ═══ Proveedor ═══ -->
                <field name="partner_name" string="Proveedor"/>
                <field name="partner_vat" string="CUIT"/>

                <!-- ═══ Comprobante ARCA ═══ -->
                <field name="display_comprobante" string="Comprobante"/>
                <field name="date" string="Fecha ARCA"/>

                <!-- ═══ Comparación importes ═══ -->
                <field name="amount_total" string="$ ARCA" sum="Total ARCA"/>
                <field name="odoo_amount_total" string="$ Odoo" sum="Total Odoo"/>
                <field name="diff_amount" string="Dif. $" sum="Total Dif."
                       decoration-danger="diff_amount != 0"/>

                <!-- ═══ Factura Odoo vinculada ═══ -->
                <field name="move_id" string="Factura Odoo" optional="show"/>
                <field name="odoo_date" string="Fecha Odoo" optional="hide"/>
                <field name="odoo_partner_name" string="Proveedor Odoo" optional="hide"/>
                <field name="odoo_partner_vat" string="CUIT Odoo" optional="show"/>
                <field name="match_detail" string="Detalle scoring" optional="hide"/>

                <!-- ═══ Campos secundarios ═══ -->
                <field name="source" widget="badge" optional="hide"
                       decoration-info="source == 'portal_iva'"
                       decoration-muted="source == 'mis_comprobantes'"/>
                <field name="afip_code" optional="hide"/>
                <field name="currency_code" optional="hide"/>
                <field name="credito_fiscal" string="Créd. Fiscal" sum="Total CF" optional="hide"/>
                <field name="amount_perc_iibb" string="Perc. IIBB" sum="Total IIBB" optional="hide"/>

                <button name="action_open_move" type="object" string="Ver"
                        icon="fa-external-link"
                        invisible="not move_id"/>
            </tree>
        </field>
    </record>

    <!-- Form view con tabs -->
    <record id="view_mis_comprobantes_line_form" model="ir.ui.view">
        <field name="name">guvens.mis.comprobantes.line.form</field>
        <field name="model">guvens.mis.comprobantes.line</field>
        <field name="arch" type="xml">
            <form string="Comprobante ARCA" create="false">
                <field name="company_id" invisible="1"/>
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_move" type="object"
                                class="oe_stat_button" icon="fa-file-text-o"
                                invisible="not move_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Ver Factura</span>
                            </div>
                        </button>
                    </div>

                    <!-- Resumen del cruce arriba -->
                    <group>
                        <group string="Resultado">
                            <field name="match_score" widget="progressbar"/>
                            <field name="match_detail"/>
                            <field name="diff_amount"/>
                        </group>
                        <group string="Importación">
                            <field name="source" readonly="1"/>
                            <field name="period"/>
                            <field name="import_date"/>
                        </group>
                    </group>

                    <notebook>
                        <!-- Tab 1: Comparación lado a lado -->
                        <page string="Comparación" name="page_comparacion">
                            <group>
                                <group string="Datos ARCA">
                                    <field name="partner_name" string="Proveedor"/>
                                    <field name="partner_vat" string="CUIT"/>
                                    <field name="display_comprobante"/>
                                    <field name="date" string="Fecha"/>
                                    <field name="amount_total" string="Total"/>
                                </group>
                                <group string="Datos Odoo">
                                    <field name="odoo_partner_name" string="Proveedor"/>
                                    <field name="odoo_partner_vat" string="CUIT"/>
                                    <field name="move_id"/>
                                    <field name="odoo_date" string="Fecha"/>
                                    <field name="odoo_amount_total" string="Total"/>
                                </group>
                            </group>
                        </page>

                        <!-- Tab 2: Detalle comprobante ARCA -->
                        <page string="Detalle ARCA" name="page_detalle">
                            <group>
                                <group string="Comprobante">
                                    <field name="doc_type"/>
                                    <field name="afip_code"
                                           invisible="source != 'portal_iva'"/>
                                    <field name="pos_number"/>
                                    <field name="doc_number"/>
                                    <field name="cae"/>
                                </group>
                                <group string="Importes">
                                    <field name="amount_net"/>
                                    <field name="amount_untaxed"/>
                                    <field name="amount_exempt"/>
                                    <field name="amount_iva"/>
                                    <field name="credito_fiscal"
                                           invisible="source != 'portal_iva'"/>
                                </group>
                            </group>
                            <group invisible="source != 'portal_iva'">
                                <group string="Multi-moneda">
                                    <field name="currency_code"/>
                                    <field name="exchange_rate"/>
                                </group>
                            </group>
                        </page>

                        <!-- Tab 3: Desglose IVA (solo Portal IVA) -->
                        <page string="Desglose IVA" name="page_iva"
                              invisible="source != 'portal_iva'">
                            <group>
                                <group string="Neto por alícuota">
                                    <field name="neto_iva_0"/>
                                    <field name="neto_iva_25"/>
                                    <field name="neto_iva_5"/>
                                    <field name="neto_iva_105"/>
                                    <field name="neto_iva_21"/>
                                    <field name="neto_iva_27"/>
                                </group>
                                <group string="IVA por alícuota">
                                    <label for="neto_iva_0" string="—"/>
                                    <div/>
                                    <field name="iva_25"/>
                                    <field name="iva_5"/>
                                    <field name="iva_105"/>
                                    <field name="iva_21"/>
                                    <field name="iva_27"/>
                                </group>
                            </group>
                        </page>

                        <!-- Tab 4: Percepciones (solo Portal IVA) -->
                        <page string="Percepciones" name="page_percepciones"
                              invisible="source != 'portal_iva'">
                            <group>
                                <group>
                                    <field name="amount_perc_iibb"/>
                                    <field name="amount_perc_iva"/>
                                    <field name="amount_perc_municipal"/>
                                </group>
                                <group>
                                    <field name="amount_perc_internos"/>
                                    <field name="amount_perc_otros_nac"/>
                                    <field name="amount_otros_tributos"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search view -->
    <record id="view_mis_comprobantes_line_search" model="ir.ui.view">
        <field name="name">guvens.mis.comprobantes.line.search</field>
        <field name="model">guvens.mis.comprobantes.line</field>
        <field name="arch" type="xml">
            <search string="Cruce Comprobantes">
                <field name="partner_name"/>
                <field name="partner_vat"/>
                <field name="doc_number"/>
                <field name="move_id"/>
                <separator/>
                <filter name="filter_portal_iva" string="Portal IVA"
                        domain="[('source', '=', 'portal_iva')]"/>
                <filter name="filter_mis_comprobantes" string="Mis Comprobantes"
                        domain="[('source', '=', 'mis_comprobantes')]"/>
                <separator/>
                <filter name="filter_match" string="Coinciden"
                        domain="[('state', '=', 'match')]"/>
                <filter name="filter_mismatch" string="Diferencia"
                        domain="[('state', '=', 'mismatch')]"/>
                <filter name="filter_missing_odoo" string="Falta en Odoo"
                        domain="[('state', '=', 'missing_in_odoo')]"/>
                <filter name="filter_missing_afip" string="Falta en ARCA"
                        domain="[('state', '=', 'missing_in_afip')]"/>
                <separator/>
                <filter name="filter_low_score" string="Confianza baja (&lt;80%)"
                        domain="[('match_score', '&gt;', 0), ('match_score', '&lt;', 80)]"/>
                <separator/>
                <filter name="group_state" string="Agrupar por estado"
                        context="{'group_by': 'state'}"/>
                <filter name="group_source" string="Agrupar por origen"
                        context="{'group_by': 'source'}"/>
                <filter name="group_partner" string="Agrupar por proveedor"
                        context="{'group_by': 'partner_name'}"/>
                <filter name="group_period" string="Agrupar por período"
                        context="{'group_by': 'period'}"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_mis_comprobantes_line" model="ir.actions.act_window">
        <field name="name">Cruce Comprobantes ARCA</field>
        <field name="res_model">guvens.mis.comprobantes.line</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_mis_comprobantes_line_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay comprobantes importados
            </p>
            <p>
                Importe un CSV desde "Mis Comprobantes" o "Portal IVA — Compras" de ARCA
                para cruzar contra las facturas de proveedores.
            </p>
        </field>
    </record>

</odoo>
