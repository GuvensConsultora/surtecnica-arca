<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_import_mis_comprobantes_form" model="ir.ui.view">
        <field name="name">guvens.import.mis.comprobantes.form</field>
        <field name="model">guvens.import.mis.comprobantes</field>
        <field name="arch" type="xml">
            <form string="Importar CSV AFIP">
                <group>
                    <field name="csv_file" filename="csv_filename"/>
                    <field name="csv_filename" invisible="1"/>
                    <field name="period" readonly="1"/>
                    <field name="detected_format" readonly="1"
                           invisible="not detected_format"/>
                </group>
                <div class="mx-3 mb-3 p-3 bg-light rounded border">
                    <h6 class="mb-2 text-muted fw-bold" style="font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.5px;">Formatos aceptados</h6>
                    <div class="d-flex gap-3">
                        <div class="flex-fill p-2 bg-white rounded border">
                            <div class="fw-bold text-primary" style="font-size: 0.85rem;">Mis Comprobantes</div>
                            <div class="text-muted" style="font-size: 0.78rem;">AFIP &gt; Mis Comprobantes &gt; Recibidos</div>
                        </div>
                        <div class="flex-fill p-2 bg-white rounded border">
                            <div class="fw-bold text-primary" style="font-size: 0.85rem;">Portal IVA — Compras</div>
                            <div class="text-muted" style="font-size: 0.78rem;">AFIP &gt; Portal IVA &gt; DDJJ Compras</div>
                        </div>
                    </div>
                    <div class="mt-2 text-muted text-center" style="font-size: 0.75rem;">El formato se detecta automáticamente al importar.</div>
                </div>
                <footer>
                    <button name="action_import" type="object"
                            string="Importar y Cruzar" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_import_mis_comprobantes" model="ir.actions.act_window">
        <field name="name">Importar CSV AFIP</field>
        <field name="res_model">guvens.import.mis.comprobantes</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
